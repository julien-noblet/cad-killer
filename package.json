{
  "name": "cad-killer",
  "version": "1.0.1",
  "description": "Visionneur de carte pour logisticiens pressés",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.11"
  },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev -p 9000",
    "build": "node ./node_modules/next/dist/bin/next build",
    "lint": "eslint . && stylelint '**/*.scss' && prettier --check .",
    "lint:js": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest && playwright test",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test -u",
    "lint:scss": "stylelint '**/*.scss'",
    "lint:scss:fix": "stylelint '**/*.scss' --fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write ."
  },
  "lint-staged": {
    "*.js": [
      "prettier --write --insert-pragma"
    ],
    "*.json": [
      "prettier --parser json --write"
    ],
    "src/**.json": [
      "prettier --parser json --write"
    ],
    "src/**/*.js": [
      "prettier --write"
    ],
    "src/*.js": [
      "prettier --write"
    ],
    "src/**/*.ts": [
      "prettier --write"
    ],
    "app/**/*.{ts,tsx}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/julien-noblet/cad-killer.git"
  },
  "keywords": [
    "osm"
  ],
  "author": "Julien Noblet",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/julien-noblet/cad-killer/issues"
  },
  "homepage": "https://github.com/julien-noblet/cad-killer",
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/eslint-parser": "^8.0.0",
    "@babel/preset-env": "8.0.6",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "commitizen": "^4.2.4",
    "cssnano": "9.0.5",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^10.4.0",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "globals": "^17.0.0",
    "husky": "9.1.7",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "17.5.1",
    "postcss": "8.5.28",
    "postcss-import": "17.0.0",
    "postcss-preset-env": "11.5.3",
    "prettier": "3.9.9",
    "sass": "^1.71.1",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.2.7",
    "leaflet": "1.9.4",
    "leaflet-hash": "0.2.1",
    "leaflet.photon": "0.9.2",
    "next": "^16.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js"
    },
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                },
                "modules": "commonjs"
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "verbose": true,
    "bail": false,
    "collectCoverage": false,
    "modulePathIgnorePatterns": [
      "sandbox",
      "node_modules",
      "e2e"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.[jt]s?(x)"
    ],
    "testEnvironment": "jsdom"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
